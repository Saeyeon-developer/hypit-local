{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypit.ai/schemas/prompt-pack.schema.json",
  "title": "Hypit provider-neutral prompt pack",
  "description": "Analysis-prompt handoff only. This format contains no provider, model, credential, receipt or pricing data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "language", "source", "target", "prompts"],
  "properties": {
    "format": { "const": "hypit.prompt-pack@1" },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "description": "BCP-47 language tag; use ko for Korean."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "durationSeconds"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?!(?:[A-Za-z]:)).+$",
          "description": "Relative path to the analyzed source media."
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "aspectRatio"],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "sourceRange", "purpose", "prompt"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "kind": { "enum": ["image", "video"] },
          "sourceRange": {
            "type": "object",
            "additionalProperties": false,
            "required": ["startSeconds", "endSeconds"],
            "properties": {
              "startSeconds": { "type": "number", "minimum": 0 },
              "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "purpose": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "negativePrompt": { "type": "string", "minLength": 1 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "aspectRatio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" },
          "referenceAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "continuityNotes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
